@page "/bikes"
@using System.Data.Common
@inject BikeService BikeService
@inject SyncStatusStateService SyncStatus
@inject PreferencesService Preferences
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@ProjectInfo.Name - @WebStrings.BikesTitle</PageTitle>

<PageHeader Title="@WebStrings.BikesTitle" Subtitle="@WebStrings.BikesSubtitle">
    <Actions>
        @if (LastUpdated is { } updated)
        {
            <MudText Typo="Typo.caption" Class="em-muted">@WebStrings.Format(WebStrings.BikeUpdated, DisplayFormat.DateTime(Preferences.ToLocal(updated)))</MudText>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh"
                   Disabled="@(_refreshing || _loading)" OnClick="RefreshAsync">
            @(_refreshing ? WebStrings.BikeRefreshing : WebStrings.BikeRefresh)
        </MudButton>
    </Actions>
</PageHeader>

<StateView Loading="_loading" ErrorMessage="@_error" OnRetry="LoadAsync" Empty="@(_bikes.Count == 0)" EmptyMessage="@WebStrings.BikeNone">
    @if (_bikes.Count == 1)
    {
        <BikeDetailsView Bike="_bikes[0]" />
    }
    else
    {
        <MudTabs Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4"
                 ActivePanelIndex="ActiveIndex" ActivePanelIndexChanged="OnTabChanged">
            @foreach (var bike in _bikes)
            {
                <MudTabPanel Text="@_labels[bike.Id]" Icon="@Icons.Material.Rounded.ElectricBike">
                    <BikeDetailsView Bike="bike" />
                </MudTabPanel>
            }
        </MudTabs>
    }
</StateView>

@code {
    private bool _loading = true;
    private bool _refreshing;
    private string? _error;
    private IReadOnlyList<BikeDetailsDto> _bikes = [];
    private IReadOnlyDictionary<string, string> _labels = new Dictionary<string, string>();

    [SupplyParameterFromQuery(Name = BikeLinks.BikeParameter)] public string? SelectedBike { get; set; }

    private DateTime? LastUpdated => _bikes.Select(bike => bike.UpdatedAt).Max();

    private int ActiveIndex => Math.Max(0, _bikes.ToList().FindIndex(bike => bike.Id == SelectedBike));

    protected override async Task OnInitializedAsync()
    {
        SyncStatus.Finished += OnSyncFinished;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _bikes = await BikeService.GetDetailsAsync();
            _labels = BikeText.Labels(_bikes.Select(bike => (bike.Id, bike.Name, (string?)bike.Model)));
        }
        catch (Exception ex) when (ex is DbException or InvalidOperationException)
        {
            _error = WebStrings.BikeLoadFailed;
        }

        _loading = false;
    }

    private async Task RefreshAsync()
    {
        _refreshing = true;
        var result = await BikeService.RefreshDetailsAsync();
        _refreshing = false;

        if (!result.Succeeded)
            Snackbar.Add(result.Message ?? WebStrings.BikeRefreshFailed, Severity.Error);
        else if (result.Value is { Count: > 0 } problems)
            Snackbar.Add(string.Join(" ", problems), Severity.Warning);
        else
            Snackbar.Add(WebStrings.BikeRefreshed, Severity.Success);

        await LoadAsync();
    }

    private void OnTabChanged(int index)
    {
        if (index < 0 || index >= _bikes.Count || _bikes[index].Id == SelectedBike) return;

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter(BikeLinks.BikeParameter, _bikes[index].Id), replace: true);
    }

    private void OnSyncFinished(SyncStatus status) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => SyncStatus.Finished -= OnSyncFinished;
}
