@page "/settings"
@page "/settings/{Section}"
@using EBikeManager.Web.Ui.Pages.Settings
@inject NavigationManager Navigation

<PageTitle>@ProjectInfo.Name - @WebStrings.SettingsTitle</PageTitle>

<PageHeader Title="@WebStrings.SettingsTitle" Subtitle="@WebStrings.SettingsSubtitle" />

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
    <MudTabs Position="@_tabPosition" Rounded="true" ApplyEffectsToContainer="true"
             Class="em-settings-tabs" TabPanelsClass="em-settings-panels"
             ActivePanelIndex="_activeIndex">
        <MudTabPanel Text="@WebStrings.SettingsTabBosch" Icon="@Icons.Material.Rounded.ElectricBike" OnClick="@(() => Open(0))">
            <SettingsBosch />
        </MudTabPanel>
        <MudTabPanel Text="@WebStrings.SettingsTabBridge" Icon="@Icons.Material.Rounded.Bluetooth" OnClick="@(() => Open(1))">
            <SettingsBridge />
        </MudTabPanel>
        <MudTabPanel Text="@GoogleHealthIntegration.Name" Icon="@Icons.Material.Rounded.MonitorHeart" OnClick="@(() => Open(2))">
            <SettingsGoogleHealth />
        </MudTabPanel>
        <MudTabPanel Text="@WebStrings.SettingsTabNotifications" Icon="@Icons.Material.Rounded.Notifications" OnClick="@(() => Open(3))">
            <SettingsNotifications />
        </MudTabPanel>
        <MudTabPanel Text="@WebStrings.SettingsTabSchedule" Icon="@Icons.Material.Rounded.Schedule" OnClick="@(() => Open(4))">
            <SettingsSchedule />
        </MudTabPanel>
        <MudTabPanel Text="@WebStrings.SettingsTabDisplay" Icon="@Icons.Material.Rounded.DisplaySettings" OnClick="@(() => Open(5))">
            <SettingsDisplay />
        </MudTabPanel>
        <MudTabPanel Text="@WebStrings.SettingsTabSecurity" Icon="@Icons.Material.Rounded.Security" OnClick="@(() => Open(6))">
            <SettingsSecurity />
        </MudTabPanel>
        <MudTabPanel Text="@WebStrings.SettingsTabAbout" Icon="@Icons.Material.Rounded.Info" OnClick="@(() => Open(7))">
            <SettingsAbout />
        </MudTabPanel>
    </MudTabs>
</MudBreakpointProvider>

@code {
    private static readonly string[] _sections = ["bosch", "bridge", "google-health", "notifications", "schedule", "display", "security", "about"];

    [Parameter] public string? Section { get; set; }

    private int _activeIndex;
    private Position _tabPosition = Position.Left;

    protected override void OnParametersSet()
    {
        var index = Array.IndexOf(_sections, Section?.ToLowerInvariant());
        _activeIndex = index >= 0 ? index : 0;
    }

    private void OnBreakpointChanged(Breakpoint breakpoint) =>
        _tabPosition = breakpoint is Breakpoint.Xs or Breakpoint.Sm ? Position.Top : Position.Left;

    private void Open(int index)
    {
        if (index == _activeIndex) return;

        _activeIndex = index;
        Navigation.NavigateTo($"/settings/{_sections[index]}");
    }
}
