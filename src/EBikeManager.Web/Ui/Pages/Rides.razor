@page "/rides"
@using System.Data.Common
@inject RideService RideService
@inject SyncStatusStateService SyncStatus
@inject BrowserInteropService Browser
@inject GoogleHealthAccountService Google
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@ProjectInfo.Name - @WebStrings.RidesTitle</PageTitle>

<PageHeader Title="@WebStrings.RidesTitle" Subtitle="@WebStrings.RidesSubtitle" />

@if (SyncStatus.Status.IsRunning)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Icon="@Icons.Material.Rounded.Sync" Class="mb-4">
        @(SyncStatus.Status.Progress ?? WebStrings.Syncing)
    </MudAlert>
}
else if (SyncStatus.Status.LastResult is { Problems.Count: > 0 } result)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
        @WebStrings.Format(WebStrings.RidesProblems, result.Problems.Count)
    </MudAlert>
}

<StateView Loading="_loading" ErrorMessage="@_error" OnRetry="LoadAsync" Empty="@(_rides.Count == 0)" EmptyMessage="@WebStrings.RidesNone">
    <MudTable Items="_rides" T="RideDto" Hover="true" Dense="true" Elevation="0" Class="em-card em-rides-table" Breakpoint="Breakpoint.Sm" RowsPerPage="25"
              RowClass="em-row-link" OnRowClick="OpenRide">
        <HeaderContent>
            <MudTh>@WebStrings.RidesRide</MudTh>
            <MudTh Style="text-align:right">@WebStrings.Distance</MudTh>
            <MudTh Style="text-align:right">@WebStrings.MovingTime</MudTh>
            <MudTh Style="text-align:right">@WebStrings.Calories</MudTh>
            <MudTh Style="text-align:right">@WebStrings.RidesYourShare</MudTh>
            <MudTh Class="em-fit-column">@WebStrings.RidesDataFiles</MudTh>
            @if (_googleConnected)
            {
                <MudTh Class="em-fit-column" Style="text-align:center">@GoogleHealthIntegration.Name</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@WebStrings.RidesRide">
                <div class="em-ride-cell" @onclick:stopPropagation="true">
                    <MudLink Href="@RideLinks.For(context.Id)" Typo="Typo.body2">@(context.Title ?? WebStrings.RideUntitled)</MudLink>
                    <MudText Typo="Typo.caption" Class="em-muted">@DisplayFormat.DateTime(context.LocalStartTime)</MudText>
                </div>
            </MudTd>
            <MudTd DataLabel="@WebStrings.Distance" Style="text-align:right">@DisplayFormat.Distance(context.DistanceMeters)</MudTd>
            <MudTd DataLabel="@WebStrings.MovingTime" Style="text-align:right">@DisplayFormat.Duration(context.MovingSeconds)</MudTd>
            <MudTd DataLabel="@WebStrings.Calories" Style="text-align:right">@DisplayFormat.Calories(context.CaloriesKcal)</MudTd>
            <MudTd DataLabel="@WebStrings.RidesYourShare" Style="text-align:right">@DisplayFormat.Percent(context.RiderEnergySharePercent)</MudTd>
            <MudTd DataLabel="@WebStrings.RidesDataFiles">
                <div class="em-files" @onclick:stopPropagation="true">
                    <BackupFileButton Format="FIT" Status="context.FitStatus" Problem="@context.FitProblem" DownloadLabel="@WebStrings.RidesDownloadFit"
                                      OnDownload="@(() => DownloadAsync(RideService.GetFitFileAsync(context.Id)))" />
                    <BackupFileButton Format="GPX" Status="context.GpxStatus" DownloadLabel="@WebStrings.RidesDownloadGpx"
                                      OnDownload="@(() => DownloadAsync(RideService.GetGpxFileAsync(context.Id)))" />
                </div>
            </MudTd>
            @if (_googleConnected)
            {
                <MudTd DataLabel="@GoogleHealthIntegration.Name" Style="text-align:center">
                    <div class="d-inline-flex" @onclick:stopPropagation="true">
                        <GoogleHealthUploadButton RideId="@context.Id" RideTitle="@context.Title" Upload="@_uploads.GetValueOrDefault(context.Id)"
                                                  Finished="@context.Finished" Compact="true" OnUploaded="ReloadUploadsAsync" />
                    </div>
                </MudTd>
            }
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="[25, 50, 100]" />
        </PagerContent>
    </MudTable>
</StateView>

@code {
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<RideDto> _rides = [];
    private bool _googleConnected;
    private IReadOnlyDictionary<string, RideExportDto> _uploads = new Dictionary<string, RideExportDto>();

    protected override async Task OnInitializedAsync()
    {
        SyncStatus.OnChange += OnSyncChanged;
        SyncStatus.Finished += OnSyncFinished;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _rides = await RideService.GetRidesAsync();
            _googleConnected = await Google.IsConnectedAsync();
            if (_googleConnected) await ReloadUploadsAsync();
        }
        catch (Exception ex) when (ex is DbException or InvalidOperationException)
        {
            _error = WebStrings.RidesLoadFailed;
        }

        _loading = false;
    }

    private async Task ReloadUploadsAsync() => _uploads = await Google.GetUploadsByRideAsync();

    private void OpenRide(TableRowClickEventArgs<RideDto> row)
    {
        if (row.Item is { } ride) Navigation.NavigateTo(RideLinks.For(ride.Id));
    }

    private async Task DownloadAsync(Task<OperationResult<ExportFile>> download)
    {
        var file = await download;
        if (!file.Succeeded || file.Value is not { } export)
        {
            Snackbar.Add(file.Message ?? WebStrings.RidesDownloadFailed, Severity.Error);
            return;
        }

        if (!await Browser.DownloadAsync(export.FileName, export.Content)) Snackbar.Add(WebStrings.RidesDownloadFailed, Severity.Error);
    }

    private void OnSyncChanged() => InvokeAsync(StateHasChanged);

    private void OnSyncFinished(SyncStatus status) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        SyncStatus.OnChange -= OnSyncChanged;
        SyncStatus.Finished -= OnSyncFinished;
    }
}
