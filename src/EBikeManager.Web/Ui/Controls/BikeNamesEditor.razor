@inject BikeService Bikes
@inject ISnackbar Snackbar

<StateView Loading="_loading" Compact="true" Empty="@(_rows.Count == 0)" EmptyMessage="@WebStrings.BikeNamesNone">
    <div class="d-flex flex-column gap-4">
        @foreach (var row in _rows)
        {
            <div role="group" aria-label="@row.Model">
                <MudText Typo="Typo.body2" Class="font-weight-bold">@row.Model</MudText>
                <MudText Typo="Typo.caption" Class="em-muted d-block mb-2">@WebStrings.BikeNamesModelFromBosch</MudText>
                <MudTextField T="string" @bind-Value="row.Name" Label="@WebStrings.BikeNamesName" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" MaxLength="BikeService.MaxNameLength" Class="em-bike-name-field"
                              Error="@string.IsNullOrWhiteSpace(row.Name)" ErrorText="@WebStrings.BikeNamesNameRequired" />
            </div>
        }
    </div>
</StateView>

@if (!_loading && _rows.Count > 0)
{
    <div class="mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Dirty || !Valid || _saving)" OnClick="SaveAsync">
            @WebStrings.BikeNamesSave
        </MudButton>
    </div>
}

@code {
    private sealed class BikeNameRow
    {
        public required string Id { get; init; }
        public required string Model { get; init; }
        public required string SavedName { get; set; }
        public string? Name { get; set; }
    }

    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _loading = true;
    private bool _saving;
    private List<BikeNameRow> _rows = [];

    private bool Dirty => _rows.Any(row => row.Name?.Trim() != row.SavedName);

    private bool Valid => _rows.All(row => !string.IsNullOrWhiteSpace(row.Name));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _rows = [.. (await Bikes.GetBikesAsync()).Select(bike => new BikeNameRow { Id = bike.Id, Model = bike.Model, SavedName = bike.Name, Name = bike.Name })];
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var result = await Bikes.SaveNamesAsync(_rows.ToDictionary(row => row.Id, row => row.Name ?? ""));
        _saving = false;
        if (!result.Succeeded)
        {
            Snackbar.Add(result.Message ?? SettingsStateService.SaveFailed, Severity.Error);
            return;
        }

        Snackbar.Add(WebStrings.BikeNamesSaved, Severity.Success);
        await LoadAsync();
        await OnSaved.InvokeAsync();
    }
}
