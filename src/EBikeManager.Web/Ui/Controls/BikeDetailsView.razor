@inject PreferencesService Preferences
@inject BridgeLiveStateService BridgeLive
@implements IDisposable

@if (!Bike.HasDetails)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@WebStrings.Format(WebStrings.BikeNoDetailsYet, Bike.Name)</MudAlert>
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="5">
            <SurfaceCard>
                @if (Bike.PictureSavedAt is { } pictureSavedAt)
                {
                    <img src="@BikeMediaEndpoint.PicturePath(Bike.Id, pictureSavedAt)" alt="@Bike.Name" class="em-bike-picture mb-4" loading="lazy" onerror="this.style.display='none'" />
                }
                <MudText Typo="Typo.h5" HtmlTag="h2" Class="font-weight-bold">@Bike.Name</MudText>
                <div class="mt-3">
                    <DataRow Label="@WebStrings.BikeModel" Value="@Bike.Model" />
                    <DataRow Label="@WebStrings.BikeFrameNumber" Value="@(Bike.FrameNumber ?? DisplayFormat.Missing)" />
                    @if (Bike.FrameNumberPosition is { } position)
                    {
                        <DataRow Label="@WebStrings.BikeFrameNumberPosition" Value="@position" />
                    }
                    <DataRow Label="@WebStrings.BikeMaxAssistSpeed" Value="@DisplayFormat.Speed(Bike.MaxAssistSpeedKmh, Units)" />
                    @if (Bike.WheelCircumferenceMm is { } wheel)
                    {
                        <DataRow Label="@WebStrings.BikeWheelCircumference" Value="@DisplayFormat.Number(wheel, "#,0 mm")" />
                    }
                    <DataRow Label="@WebStrings.BikeWalkAssist" Value="@BikeText.YesNo(Bike.WalkAssistEnabled)" />
                    @if (Bike.LockEnabled != null)
                    {
                        <DataRow Label="@WebStrings.BikeLock" Value="@BikeText.OnOff(Bike.LockEnabled)" />
                    }
                    @if (Bike.AlarmEnabled != null)
                    {
                        <DataRow Label="@WebStrings.BikeAlarm" Value="@BikeText.OnOff(Bike.AlarmEnabled)" />
                    }
                    <DataRow Label="@WebStrings.BikeFlowPlus" Value="@BikeText.YesNo(Bike.HasFlowPlus)" />
                    @if (Bike.ServiceDue is { } service)
                    {
                        <DataRow Label="@WebStrings.BikeServiceDue" Value="@ServiceDueText(service)" />
                    }
                </div>
            </SurfaceCard>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudGrid Spacing="4">
                <MudItem xs="12">
                    <SurfaceCard Icon="@Icons.Material.Rounded.Route" Title="@WebStrings.BikeMileage">
                        <div class="d-flex flex-wrap justify-space-between align-end gap-4">
                            <div>
                                <div class="em-stat-value">
                                    <MudText Typo="Typo.h4" Class="em-hero-value font-weight-bold">@DisplayFormat.DistanceNumber(BikeText.OdometerMeters(Bike, Live), Units, "#,0")</MudText>
                                    <MudText Typo="Typo.body1" Class="em-muted">@UnitConversion.DistanceUnit(Units)</MudText>
                                </div>
                                <MudText Typo="Typo.caption" Class="em-muted d-block">@WebStrings.BikeMileageLabel</MudText>
                            </div>
                            <div class="text-right">
                                <div class="em-stat-value justify-end">
                                    <MudText Typo="Typo.h6" Class="em-hero-value font-weight-bold">@DisplayFormat.Number(Bike.MotorHours, "#,0")</MudText>
                                    <MudText Typo="Typo.body2" Class="em-muted">h</MudText>
                                </div>
                                <MudText Typo="Typo.caption" Class="em-muted d-block">@MotorHoursText(Bike)</MudText>
                            </div>
                        </div>
                        @if (Bike.ModeMileage.Count > 0)
                        {
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">@WebStrings.BikeMileageByMode</MudText>
                            <div class="em-mode-bar mb-3" role="img" aria-label="@MileageText(Bike)">
                                @foreach (var mode in Bike.ModeMileage.Where(mode => mode.Percent > 0))
                                {
                                    <span class="em-mode-segment" style="@SegmentStyle(mode)"></span>
                                }
                            </div>
                            <div class="em-mileage">
                                @foreach (var mode in Bike.ModeMileage)
                                {
                                    <div class="d-flex align-center gap-2">
                                        <span class="em-mode-dot" style="@BikeText.ModeBackground(mode.Color, mode.IsOff)"></span>
                                        <MudText Typo="Typo.body2">@mode.Name</MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Class="text-right font-weight-bold">@DisplayFormat.Distance(mode.DistanceMeters, Units)</MudText>
                                    <MudText Typo="Typo.body2" Class="text-right em-muted">@DisplayFormat.Percent(mode.Percent)</MudText>
                                    <MudText Typo="Typo.body2" Class="text-right em-muted">@DisplayFormat.WattHours(mode.EnergyWh)</MudText>
                                }
                            </div>
                        }
                    </SurfaceCard>
                </MudItem>
                @foreach (var battery in Bike.Batteries)
                {
                    <MudItem xs="12" sm="6">
                        <StatTile Icon="@Icons.Material.Rounded.BatteryChargingFull" Title="@(battery.ProductName ?? WebStrings.BikeBattery)"
                                  Value="@DisplayFormat.Number(battery.ChargeCycles, "0.#")" Label="@WebStrings.BikeChargeCycles">
                            <DataRow Label="@WebStrings.BikeCapacity" Value="@DisplayFormat.WattHours(battery.CapacityWh)" />
                            @if (BikeText.ChargeLevel(Bike, battery, Live) is { } level)
                            {
                                <DataRow Label="@WebStrings.BikeChargeLevel" Value="@ChargeLevelText(level)" />
                            }
                            <DataRow Label="@WebStrings.BikeLifetimeEnergy" Value="@DisplayFormat.KilowattHours(battery.LifetimeDeliveredWh)" />
                            <DataRow Label="@WebStrings.BikeCyclesOnOffBike" Value="@($"{DisplayFormat.Number(battery.ChargeCyclesOnBike, "0.#")} / {DisplayFormat.Number(battery.ChargeCyclesOffBike, "0.#")}")" />
                        </StatTile>
                    </MudItem>
                }
                @if (Bike.AssistModes.Count > 0)
                {
                    <MudItem xs="12" sm="6">
                        <SurfaceCard Icon="@Icons.Material.Rounded.Speed" Title="@WebStrings.BikeRange" Description="@WebStrings.BikeRangeDescription">
                            @{ var longest = Bike.AssistModes.Max(mode => mode.ReachableRangeKm ?? 0); }
                            @foreach (var mode in Bike.AssistModes)
                            {
                                <div class="em-range-row">
                                    <div class="d-flex justify-space-between align-center">
                                        <div class="d-flex align-center gap-2">
                                            <span class="em-mode-dot" style="@BikeText.ModeBackground(mode.Color)"></span>
                                            <MudText Typo="Typo.body2">@mode.Name</MudText>
                                        </div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@DisplayFormat.WholeDistance(mode.ReachableRangeKm * UnitConversion.MetresPerKilometre, Units)</MudText>
                                    </div>
                                    <MudProgressLinear Value="@(longest > 0 ? (mode.ReachableRangeKm ?? 0) * 100 / longest : 0)" Color="Color.Primary" Rounded="true" Size="Size.Small" />
                                </div>
                            }
                        </SurfaceCard>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>

        @if (Live is { } bridge)
        {
            <MudItem xs="12" md="6">
                <SurfaceCard Icon="@Icons.Material.Rounded.Bluetooth" Title="@WebStrings.BikeBridgeTitle" Description="@WebStrings.BikeBridgeDescription">
                    <DataRow Label="@WebStrings.BikeChargeLevel" Value="@DisplayFormat.Percent(bridge.BatteryPercent)" />
                    <DataRow Label="@WebStrings.BikeSpeed" Value="@DisplayFormat.Speed(bridge.SpeedKmh, Units)" />
                    <DataRow Label="@WebStrings.BikeCadence" Value="@DisplayFormat.Number(bridge.CadenceRpm, "0 'rpm'")" />
                    <DataRow Label="@WebStrings.BikeRiderPower" Value="@DisplayFormat.Number(bridge.RiderPowerWatts, "0 'W'")" />
                    <DataRow Label="@WebStrings.BikeMoving" Value="@BikeText.YesNo(bridge.InMotion)" />
                    <DataRow Label="@WebStrings.BikeChargerConnected" Value="@BikeText.YesNo(bridge.ChargerConnected)" />
                    @if (bridge.ChargeTimeTo80Minutes is { } to80)
                    {
                        <DataRow Label="@WebStrings.BikeChargeTo80" Value="@DisplayFormat.Duration(to80 * 60)" />
                    }
                    @if (bridge.ChargeTimeTo100Minutes is { } to100)
                    {
                        <DataRow Label="@WebStrings.BikeChargeTo100" Value="@DisplayFormat.Duration(to100 * 60)" />
                    }
                    <DataRow Label="@WebStrings.BikeLocked" Value="@BikeText.YesNo(bridge.Locked)" />
                    <DataRow Label="@WebStrings.BikeLight" Value="@BikeText.OnOff(bridge.LightOn)" />
                    <DataRow Label="@WebStrings.BikeLightReserve" Value="@BikeText.YesNo(bridge.LightReserveActive)" />
                    <DataRow Label="@WebStrings.BikeDiagnosis" Value="@BikeText.YesNo(bridge.DiagnosisActive)" />
                    <DataRow Label="@WebStrings.BikeAmbientLight" Value="@DisplayFormat.Number(bridge.AmbientBrightnessLux, "0.# 'lx'")" />
                </SurfaceCard>
            </MudItem>
        }

        @if (Bike.LiveState is { } live)
        {
            <MudItem xs="12" md="6">
                <SurfaceCard Icon="@Icons.Material.Rounded.Bolt" Title="@WebStrings.BikeLiveTitle" Description="@WebStrings.BikeLiveDescription">
                    <DataRow Label="@WebStrings.BikeChargeLevel" Value="@DisplayFormat.Percent(live.ChargePercent)" />
                    <DataRow Label="@WebStrings.BikeCharging" Value="@BikeText.YesNo(live.Charging)" />
                    <DataRow Label="@WebStrings.BikeChargerConnected" Value="@BikeText.YesNo(live.ChargerConnected)" />
                    <DataRow Label="@WebStrings.BikeRemainingEnergy" Value="@DisplayFormat.WattHours(live.RemainingWh)" />
                    <DataRow Label="@WebStrings.BikeLiveRange" Value="@RangeText(live)" />
                    @if (live.UpdatedAt is { } liveUpdated)
                    {
                        <DataRow Label="@WebStrings.BikeLiveUpdated" Value="@DisplayFormat.DateTime(Preferences.ToLocal(liveUpdated))" />
                    }
                </SurfaceCard>
            </MudItem>
        }

        @if (Bike.LastLocation is { } location)
        {
            <MudItem xs="12" md="6">
                <SurfaceCard Icon="@Icons.Material.Rounded.LocationOn" Title="@WebStrings.BikeLocationTitle" Description="@WebStrings.BikeLocationDescription">
                    <DataRow Label="@WebStrings.BikeCoordinates" Value="@BikeText.Coordinates(location.Latitude, location.Longitude)" />
                    <DataRow Label="@WebStrings.BikeAccuracy" Value="@DisplayFormat.ShortDistance(location.AccuracyMeters, Units)" />
                    @if (location.DetectedAt is { } seen)
                    {
                        <DataRow Label="@WebStrings.BikeSeenAt" Value="@DisplayFormat.DateTime(Preferences.ToLocal(seen))" />
                    }
                    <div class="mt-3">
                        <MudButton Href="@BikeText.MapUrl(location.Latitude, location.Longitude)" Target="_blank" Variant="Variant.Text" Color="Color.Primary"
                                   EndIcon="@Icons.Material.Rounded.OpenInNew">@WebStrings.BikeOpenMap</MudButton>
                    </div>
                </SurfaceCard>
            </MudItem>
        }

        <MudItem xs="12" md="@(Bike.Documents.Count > 0 ? 7 : 12)">
            <SurfaceCard Icon="@Icons.Material.Rounded.Memory" Title="@WebStrings.BikeComponentsTitle" Description="@WebStrings.BikeComponentsDescription">
                <MudTable Items="ComponentRows(Bike)" T="ComponentRow" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>@WebStrings.BikeComponent</MudTh>
                        <MudTh>@WebStrings.BikeSoftware</MudTh>
                        <MudTh>@WebStrings.BikeSerialNumber</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@WebStrings.BikeComponent">
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@(context.Product ?? context.Name)</MudText>
                                @if (context.Product != null)
                                {
                                    <MudText Typo="Typo.caption" Class="em-muted">@context.Name</MudText>
                                }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="@WebStrings.BikeSoftware">@(context.Software ?? DisplayFormat.Missing)</MudTd>
                        <MudTd DataLabel="@WebStrings.BikeSerialNumber" Class="em-serial">@(context.Serial ?? DisplayFormat.Missing)</MudTd>
                    </RowTemplate>
                </MudTable>
            </SurfaceCard>
        </MudItem>

        @if (Bike.Documents.Count > 0)
        {
            <MudItem xs="12" md="5">
                <SurfaceCard Icon="@Icons.Material.Rounded.Description" Title="@WebStrings.BikeDocumentsTitle" Description="@WebStrings.BikeDocumentsDescription">
                    <div class="em-documents">
                        @foreach (var document in Bike.Documents)
                        {
                            <a class="em-document" href="@BikeMediaEndpoint.DocumentPath(Bike.Id, document)" target="_blank" rel="noopener">
                                @if (document.IsImage)
                                {
                                    <img src="@BikeMediaEndpoint.DocumentPath(Bike.Id, document)" alt="" class="em-document-preview" loading="lazy" />
                                }
                                else
                                {
                                    <span class="em-document-preview em-document-icon">
                                        <MudIcon Icon="@Icons.Material.Rounded.PictureAsPdf" />
                                    </span>
                                }
                                <span class="em-document-text">
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@BikeText.DocumentName(document.Kind)</MudText>
                                    <MudText Typo="Typo.caption" Class="em-muted">@DocumentDate(document)</MudText>
                                </span>
                                <MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" Class="em-muted" />
                            </a>
                        }
                    </div>
                </SurfaceCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private sealed record ComponentRow(string Name, string? Product, string? Software, string? Serial);

    [Parameter, EditorRequired] public BikeDetailsDto Bike { get; set; } = default!;

    [CascadingParameter(Name = DisplayFormat.UnitsCascade)] public UnitSystem Units { get; set; }

    private BridgeReadingsDto? Live => BridgeLive.Snapshot.LiveFor(Bike.Id);

    protected override void OnInitialized() => BridgeLive.OnChange += OnBridgeChanged;

    public void Dispose() => BridgeLive.OnChange -= OnBridgeChanged;

    private void OnBridgeChanged() => InvokeAsync(StateHasChanged);

    private string ChargeLevelText(double level) =>
        BikeText.ChargeLevelIsStored(Bike, Live) && Bike.BridgeBatteryReadAt is { } readAt
            ? WebStrings.Format(WebStrings.BikeChargeLevelRead, DisplayFormat.Percent(level), DisplayFormat.DateTime(Preferences.ToLocal(readAt)))
            : DisplayFormat.Percent(level);

    private static List<ComponentRow> ComponentRows(BikeDetailsDto bike) =>
    [
        .. bike.Components.Where(component => component.Kind == BikeComponentKind.DriveUnit).Select(Row),
        .. bike.Batteries.Select(battery => new ComponentRow(WebStrings.BikeBattery, battery.ProductName, battery.SoftwareVersion, battery.SerialNumber)),
        .. bike.Components.Where(component => component.Kind != BikeComponentKind.DriveUnit).Select(Row)
    ];

    private static ComponentRow Row(BikeComponentDto component) =>
        new(BikeText.ComponentName(component.Kind), component.ProductName, component.SoftwareVersion, component.SerialNumber);

    private static string MotorHoursText(BikeDetailsDto bike) =>
        WebStrings.Format(WebStrings.BikeMotorHoursLabel, DisplayFormat.Number(bike.MotorHoursAssisted, "#,0"));

    private string MileageText(BikeDetailsDto bike) =>
        string.Join(", ", bike.ModeMileage.Select(mode => $"{mode.Name} {DisplayFormat.Distance(mode.DistanceMeters, Units)}"));

    private static string SegmentStyle(AssistModeMileageDto mode) =>
        FormattableString.Invariant($"flex-grow:{mode.Percent};{BikeText.ModeBackground(mode.Color, mode.IsOff)}");

    private string DocumentDate(BikeDocumentDto document) =>
        WebStrings.Format(WebStrings.BikeDocumentAdded, DisplayFormat.Date(Preferences.ToLocal(document.AddedAt ?? document.SavedAt)));

    private string RangeText(BikeLiveStateDto live) =>
        live.MinRangeKm is { } min && live.MaxRangeKm is { } max && Math.Abs(max - min) >= 1
            ? WebStrings.Format(WebStrings.BikeRangeBetween, RangeNumber(min), RangeNumber(max), UnitConversion.DistanceUnit(Units))
            : DisplayFormat.WholeDistance(live.MaxRangeKm * UnitConversion.MetresPerKilometre, Units);

    private string RangeNumber(double kilometres) => DisplayFormat.DistanceNumber(kilometres * UnitConversion.MetresPerKilometre, Units, "#,0");

    private string ServiceDueText(ServiceDueDto service) =>
        (service.Date, service.OdometerMeters) switch
        {
            ({ } date, { } meters) => WebStrings.Format(WebStrings.BikeServiceDueBoth, DisplayFormat.Date(Preferences.ToLocal(date)), DisplayFormat.WholeDistance(meters, Units)),
            ({ } date, null) => DisplayFormat.Date(Preferences.ToLocal(date)),
            (null, { } meters) => WebStrings.Format(WebStrings.BikeServiceDueDistance, DisplayFormat.WholeDistance(meters, Units)),
            _ => DisplayFormat.Missing
        };
}
