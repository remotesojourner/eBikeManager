<div class="d-flex justify-space-between align-center gap-4 py-1">
    <MudText Typo="Typo.body2" Class="em-muted">@Label</MudText>
    @if (ChildContent != null)
    {
        @ChildContent
    }
    else
    {
        <MudText Typo="Typo.body2" Class="text-right">@Value</MudText>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
