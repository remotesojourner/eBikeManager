@inject BoschAccountService Bosch
@inject BikeService Bikes
@inject ISnackbar Snackbar

<StateView Loading="_loading" ErrorMessage="@_error" OnRetry="RefreshAsync" Compact="true"
           Empty="@(_available.Count == 0)" EmptyMessage="@WebStrings.BikesNoneOnAccount">
    <div class="d-flex flex-column">
        @foreach (var bike in _available)
        {
            <MudCheckBox T="bool" Value="@IsSelected(bike)" ValueChanged="@(selected => ToggleAsync(bike, selected))"
                         Label="@Label(bike)" Color="Color.Primary" />
        }
    </div>
</StateView>

@if (!_loading && _error == null)
{
    <div class="d-flex flex-wrap gap-2 mt-3">
        @Actions
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh"
                   Disabled="@_refreshing" OnClick="RefreshAsync">
            @(_refreshing ? WebStrings.BikeRefreshing : WebStrings.BikesRefresh)
        </MudButton>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<BoschBikeInfo> Selected { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<BoschBikeInfo>> SelectedChanged { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    private bool _loading = true;
    private bool _refreshing;
    private string? _error;
    private IReadOnlyList<BoschBikeInfo> _available = [];
    private IReadOnlyDictionary<string, string> _savedNames = new Dictionary<string, string>();

    protected override async Task OnInitializedAsync()
    {
        var saved = await Bikes.GetBikesAsync();
        _savedNames = saved.ToDictionary(bike => bike.Id, bike => bike.Name);
        _available = [.. saved.Select(bike => new BoschBikeInfo(bike.Id, bike.Model))];
        if (_available.Count == 0)
        {
            await RefreshAsync();
            return;
        }

        _loading = false;
        if (Selected.Count == 0) await SelectedChanged.InvokeAsync(_available);
    }

    private async Task RefreshAsync()
    {
        var firstRead = _available.Count == 0;
        _loading = firstRead;
        _refreshing = true;
        _error = null;
        var result = await Bosch.GetBikesAsync();
        _loading = false;
        _refreshing = false;

        if (!result.Succeeded)
        {
            var message = result.Message ?? WebStrings.BikesLoadFailed;
            if (firstRead) _error = message;
            else Snackbar.Add(message, Severity.Error);
            return;
        }

        _available = result.Value ?? [];
        IReadOnlyList<BoschBikeInfo> chosen = firstRead && Selected.Count == 0 ? _available : [.. _available.Where(IsSelected)];
        await SelectedChanged.InvokeAsync(chosen);
        if (!firstRead) Snackbar.Add(WebStrings.BikesRefreshed, Severity.Success);
    }

    private string Label(BoschBikeInfo bike) =>
        _savedNames.TryGetValue(bike.Id, out var name) ? BikeText.WithModel(name, bike.Name) : bike.Name;

    private bool IsSelected(BoschBikeInfo bike) => Selected.Any(chosen => chosen.Id == bike.Id);

    private Task ToggleAsync(BoschBikeInfo bike, bool selected)
    {
        var chosen = Selected.Where(existing => existing.Id != bike.Id).ToList();
        if (selected) chosen.Add(bike);
        return SelectedChanged.InvokeAsync(_available.Where(available => chosen.Any(item => item.Id == available.Id)).ToList());
    }
}
