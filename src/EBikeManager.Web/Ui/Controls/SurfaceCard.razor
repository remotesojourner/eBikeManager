<MudCard Elevation="0" Class="@CardClass()">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="d-flex align-center gap-2 @(string.IsNullOrEmpty(Description) ? "mb-3" : "mb-1")">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <MudIcon Icon="@Icon" Class="em-muted" Size="Size.Small" />
            }
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@Title</MudText>
        </div>
    }
    @if (!string.IsNullOrEmpty(Description))
    {
        <MudText Typo="Typo.caption" Class="em-muted mb-3 d-block">@Description</MudText>
    }

    @ChildContent

    @if (Actions != null)
    {
        <div class="d-flex flex-wrap gap-2 mt-4">
            @Actions
        </div>
    }
</MudCard>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool FullHeight { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    private string CardClass()
    {
        var parts = new List<string> { "em-card", "pa-5" };
        if (FullHeight) parts.Add("em-fill");
        if (!string.IsNullOrEmpty(Class)) parts.Add(Class);
        return string.Join(" ", parts);
    }
}
